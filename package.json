{
  "name": "notification-system-fix",
  "private": true,
  "description": "CRM + סוכן רשת (agent/) + ראדאר מכרזים. הסורק והסוכן חסרי תלויות; החבילה נדרשת רק לסקירת ה-AI האופציונלית.",
  "scripts": {
    "test": "node --test tenders/test/*.test.js agent/test/*.test.js test/*.test.js",
    "test:agent": "node --test agent/test/*.test.js",
    "agent": "node agent/run.js",
    "export-server": "node export-server.js",
    "dashboard": "node start-dashboard.js",
    "ai-agent": "node ai-agent.js",
    "ai-agent:daemon": "nohup node ai-agent.js > ai-agent.log 2>&1 &",
    "ai-agent:proactive": "node ai-proactive-agent.js",
    "ai-agent:proactive:daemon": "nohup node ai-proactive-agent.js > ai-agent-proactive.log 2>&1 &",
    "firebase:sync": "node firebase-sync.js",
    "firebase:sync:daemon": "nohup node firebase-sync.js > firebase-sync.log 2>&1 &",
    "test:py": "python3 -m unittest discover -p \"test_*.py\" -v",
    "test:all": "npm test && npm run test:py",
    "demo": "node test-data-generator.js && node start-dashboard.js",
    "test:ai": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "express": "^4.18.2",
    "exceljs": "^4.3.0",
    "sqlite3": "^5.1.6"
  }
}
